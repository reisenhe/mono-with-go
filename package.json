{
  "name": "mono-with-go",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "dev:api": "docker compose up api-go",
    "dev:api:build": "docker compose up api-go --build",
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:api\"",
    "start:all": "powershell -ExecutionPolicy Bypass -File ./scripts/start-all.ps1",
    "stop:all": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-all.ps1",
    "docker:logs": "docker compose logs -f api-go"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}